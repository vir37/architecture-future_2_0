        <mxCell id="5qwLMNRW6xUqnRGqiV8N-58" value="Развертывание Data Lakehouse (Ic&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;eberg)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#FF6666;" vertex="1" parent="1">
